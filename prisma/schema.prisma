generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  date        String
  time        String
  location    String
  latitude    Float?
  longitude   Float?
  organizer   String
  category    String     @default("other")
  price       String
  rawText     String
  imageUrl    String?
  sourceUrl   String?
  externalId  String?
  origin      String     @default("user")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById Int?
  createdBy   User?      @relation(fields: [createdById], references: [id])
  favorites   Favorite[]
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  password      String
  name          String?
  role          String     @default("user")
  type          String     @default("user")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  createdEvents Event[]
  favorites     Favorite[]
}

model CronSource {
  id                Int      @id @default(autoincrement())
  name              String
  listUrl           String
  scheduleCron      String   @default("0 4 * * *")
  timezone          String   @default("Europe/Rome")
  eventLinkSelector String   @default("a[href]")
  listingContainerSelector String?
  nextPageSelector  String?
  includePattern    String?
  excludePattern    String?
  waitMs            Int      @default(3000)
  requestTimeoutMs  Int      @default(60000)
  maxPages          Int      @default(10)
  maxLinksPerRun    Int      @default(200)
  renderJs          Boolean  @default(true)
  isActive          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
}

model CronJobRun {
  id            Int       @id @default(autoincrement())
  jobKey        String    @unique // e.g. "visitpedemontana", "instagram-story"
  status        String    @default("running") // "running" | "completed" | "failed"
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  resultJson    String?   // JSON-serialized result/summary
}
