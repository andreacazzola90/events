generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  date        String
  time        String
  location    String
  latitude    Float?
  longitude   Float?
  organizer   String
  category    String     @default("other")
  price       String
  rawText     String
  imageUrl    String?
  sourceUrl   String?
  externalId  String?
  origin      String     @default("user")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById Int?
  createdBy   User?      @relation(fields: [createdById], references: [id])
  eventSeriesId Int?
  eventSeries EventSeries? @relation(fields: [eventSeriesId], references: [id], onDelete: SetNull)
  favorites   Favorite[]
  calendarDeliveries GoogleCalendarDelivery[]
  media       EventMedia[]
  telegramPublications TelegramPublication[]

  @@index([eventSeriesId, date, time])
}

model EventSeries {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String   @default("")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      Event[]

  @@index([isPublished, updatedAt])
}

model SiteSettings {
  id         String   @id @default("global")
  categories Json     @default("[]")
  quotes     Json     @default("[]")
  updatedAt  DateTime @updatedAt
}

model EventMedia {
  id          Int      @id @default(autoincrement())
  eventId     Int
  kind        String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String   @unique
  url         String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
}

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  password        String
  name            String?
  role            String     @default("user")
  type            String     @default("user")
  emailVerifiedAt DateTime?
  calendarEmail   String?
  calendarCategories String[] @default([]) @ignore
  calendarEventType String @default("default")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  createdEvents   Event[]
  favorites       Favorite[]
  googleCalendar  GoogleCalendarConnection?
  calendarDeliveries GoogleCalendarDelivery[]
  telegramConnection TelegramConnection?
}

model TelegramConnection {
  id                 String   @id @default(cuid())
  userId             Int      @unique
  botId              String   @unique
  botUsername        String
  encryptedToken     String?
  webhookSecretHash  String?
  status             String   @default("connecting")
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources            TelegramSource[]
}

model TelegramSource {
  id                    String   @id @default(cuid())
  connectionId          String
  chatId                String
  title                 String
  chatType              String
  publicUsername        String?
  isActive              Boolean  @default(false)
  revision              Int      @default(1)
  removedAt             DateTime?
  consentedAt           DateTime?
  verifiedAt            DateTime?
  lastError             String?
  lastScannedAt         DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  connection            TelegramConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messages              TelegramMessage[]

  @@unique([connectionId, chatId])
  @@index([isActive, lastScannedAt])
}

model TelegramMessage {
  id             String   @id @default(cuid())
  sourceId       String
  messageId      Int
  updateId       BigInt
  version        Int      @default(1)
  rawText        String?
  photoFileId    String?
  status         String   @default("pending")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  leaseId        String?
  leasedUntil    DateTime?
  expiresAt      DateTime
  lastError      String?
  publishedCount Int      @default(0)
  discardedCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  source         TelegramSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  publications   TelegramPublication[]

  @@unique([sourceId, messageId])
  @@index([status, nextAttemptAt])
  @@index([expiresAt])
}

model TelegramPublication {
  fingerprint String   @id
  messageId   String?
  eventId     Int?
  createdAt   DateTime @default(now())
  message     TelegramMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  event       Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([messageId])
}

model GoogleCalendarConnection {
  userId       Int      @id
  email        String
  refreshToken String
  calendarId   String   @default("primary")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleCalendarDelivery {
  id            String    @id @default(cuid())
  userId        Int
  eventId       Int
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  leasedUntil   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([status, nextAttemptAt])
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model CronSource {
  id                Int      @id @default(autoincrement())
  name              String
  listUrl           String
  scheduleCron      String   @default("0 4 * * *")
  timezone          String   @default("Europe/Rome")
  eventLinkSelector String   @default("a[href]")
  listingContainerSelector String?
  nextPageSelector  String?
  includePattern    String?
  excludePattern    String?
  waitMs            Int      @default(3000)
  requestTimeoutMs  Int      @default(60000)
  maxPages          Int      @default(10)
  maxLinksPerRun    Int      @default(200)
  renderJs          Boolean  @default(true)
  isActive          Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, eventId])
}

model CronJobRun {
  id            Int       @id @default(autoincrement())
  jobKey        String    @unique // e.g. "visitpedemontana", "instagram-story"
  status        String    @default("running") // "running" | "completed" | "failed"
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  resultJson    String?   // JSON-serialized result/summary
}
